# ==============================================================================
# IoT Risk Detection and Automated Response Platform - Configuration
# ==============================================================================

# Server Network Settings
# Bind to 0.0.0.0 to allow access from any device on the local network (LAN)
# Bind to 127.0.0.1 for local machine access only
HOST=0.0.0.0
PORT=8000

# Browser Launcher
# Set to 'true' if running on headless server, Raspberry Pi, or inside Docker
NO_BROWSER=false

# Development Auto-Reload
RELOAD=false

# Scanner Settings
# Default target CIDR (comma-separated). Leave empty for auto-detection of local subnets.
# TARGET_CIDR=192.168.1.0/24,10.0.0.0/24
